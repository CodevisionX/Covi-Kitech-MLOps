# MLOps 스택 환경 변수 예시
# 사용법: cp .env.example .env 후 비밀번호 등을 변경하세요. (.env 는 git 에 올라가지 않습니다)

# --- PostgreSQL (MLflow 메타데이터) ---
POSTGRES_USER=kitech
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlflow_db
POSTGRES_PORT=5432

# --- Object Storage (RustFS, S3 호환) ---
RUSTFS_VERSION=1.0.1
# 운영 환경에서는 반드시 기본값(rustfsadmin)이 아닌 값으로 변경
S3_ACCESS_KEY=mlops-admin
S3_SECRET_KEY=change-me-s3-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001
MLFLOW_S3_ENDPOINT_URL=http://rustfs:9000
MLFLOW_BUCKET_NAME=mlflow-artifacts
DATASET_BUCKET_NAME=datasets
# 데이터셋 브라우저 업로드: 브라우저가 RustFS(S3_PORT)로 직접 올립니다.
# 비우면 "접속한 주소의 호스트:S3_PORT" 를 씁니다. 리버스 프록시/HTTPS 뒤라면 실제 주소를 적으세요.
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.local
# 업로드를 허용할 UI 주소(쉼표 구분). 기본 * (업로드 URL 은 서명돼 있어 키 없이는 못 씀)
# S3_CORS_ALLOWED_ORIGINS=http://10.0.0.5,http://localhost:4200

# --- MLflow ---
MLFLOW_PORT=15000
# MLflow 3 서버가 허용할 Host 헤더 목록(쉼표 구분, 와일드카드 가능). 비워 두면 compose 기본값 사용.
# 다른 PC에서 도메인 이름으로 MLflow 화면에 접속한다면 그 이름을 추가하세요. 예: mlflow,mlflow:5000,localhost:*,mlops.example.com:*
# MLFLOW_ALLOWED_HOSTS=

# --- Backend / UI ---
BACKEND_PORT=18000
UI_PORT=18080
# 프로젝트당 동시에 띄울 수 있는 서빙 수 (검출 + 인식을 함께 확인하려면 2 이상)
MAX_DEPLOYMENTS_PER_PROJECT=2

# --- Images ---
TRAINING_IMAGE=ghcr.io/codevisionx/covi-kitech-mlops-training:latest
# YOLO26 검출 / PP-OCRv6 인식 학습 이미지
TRAINING_IMAGE_YOLO26=ghcr.io/codevisionx/covi-kitech-mlops-training-yolo26:latest
TRAINING_IMAGE_PPOCR=ghcr.io/codevisionx/covi-kitech-mlops-training-ppocr:latest
# 로컬 빌드 시 CUDA 빌드 선택 (docker compose -f docker-compose.dev.yml --profile tools build)
# 고객 배포 GPU(RTX A4000): cu126 / Blackwell(RTX 50xx): YOLO26=cu130, PP-OCR=cu129
TRAINING_CUDA_FLAVOR_YOLO26=cu126
TRAINING_CUDA_FLAVOR_PPOCR=cu126
SERVING_IMAGE=ghcr.io/codevisionx/covi-kitech-mlops-base:latest
